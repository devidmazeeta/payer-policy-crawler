# Virtual environment
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Run artefacts. These are regenerated by every run; the deliverable copies
# (output/output.csv, logs/, and the run summary) are committed deliberately
# with `git add -f` when they are part of a submission.
downloads/
state/*.db
state/*.db-wal
state/*.db-shm
state/*.json

# Email credentials - never commit these. See README.md for setup.
credentials.json
token.json
.env

# IDE / OS
.idea/workspace.xml
.idea/dataSources*
.DS_Store
Thumbs.db
